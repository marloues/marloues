{
  "name": "marloues-workspace",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "client",
    "site"
  ],
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "npm run dev --workspace marloues",
    "build": "npm run build --workspace marloues",
    "start": "npm run start --workspace marloues",
    "typecheck": "npm run typecheck --workspace marloues",
    "test": "npm run test:unit",
    "test:layout": "node tests/check-layout.mjs",
    "test:unit": "npm run test:unit --workspace marloues",
    "test:contract": "npm run test:contract --workspace marloues",
    "test:contract:runtime": "npm run test:contract:runtime --workspace marloues",
    "test:contract:redaction": "npm run test:contract:redaction --workspace marloues",
    "test:contract:hot-update-pages": "npm run test:contract:hot-update-pages --workspace marloues",
    "test:contract:release-packaging": "npm run test:contract:release-packaging --workspace marloues",
    "test:e2e": "npm run test:e2e --workspace marloues",
    "test:smoke:runtime": "npm run test:smoke:runtime --workspace marloues",
    "test:smoke:process-sandbox": "npm run test:smoke:process-sandbox --workspace marloues",
    "test:smoke:live-runtime": "npm run test:smoke:live-runtime --workspace marloues",
    "test:smoke:binary-live": "npm run test:smoke:binary-live --workspace marloues",
    "test:smoke:runtime-extensions": "npm run test:smoke:runtime-extensions --workspace marloues",
    "test:smoke:marketplace-live": "npm run test:smoke:marketplace-live --workspace marloues",
    "test:smoke:electron-live-ui": "npm run test:smoke:electron-live-ui --workspace marloues",
    "test:smoke:electron-binary-live-ui": "npm run test:smoke:electron-binary-live-ui --workspace marloues",
    "test:visual": "npm run test:visual --workspace marloues",
    "test:conversation:preview": "npm run dev:conversation --workspace marloues",
    "test:conversation:build": "node tests/contract/conversation-build.probe.mjs",
    "test:conversation:desktop": "node tests/smoke/conversation-app.integration.mjs",
    "test:conversation:visual": "node tests/visual/conversation-details.interaction.mjs",
    "test:conversation:complete": "node tests/visual/conversation-complete.electron.mjs",
    "test:conversation:real": "node tests/visual/conversation-real.electron.mjs",
    "test:conversation:real:report": "node tests/contract/conversation-real-report.mjs",
    "test:conversation:live": "node tests/smoke/conversation-app.integration.mjs --live",
    "test:conversation:report": "node tests/contract/conversation-verification-report.mjs",
    "lint": "npm run lint:client && npm run lint:tests",
    "lint:client": "npm run lint --workspace marloues",
    "lint:tests": "node node_modules/eslint/bin/eslint.js --config tests/eslint.config.mjs tests",
    "format": "npm run format --workspace marloues",
    "generate:icons": "node gen-dock-icon.cjs",
    "rebuild:native": "npm run rebuild:native --workspace marloues",
    "package:dir": "npm run package:dir --workspace marloues",
    "package:smoke": "npm run package:smoke --workspace marloues",
    "package:mac": "npm run package:mac --workspace marloues",
    "package:win": "npm run package:win --workspace marloues",
    "package:linux": "npm run package:linux --workspace marloues",
    "release": "npm run release --workspace marloues",
    "key:hot": "npm run key:hot --workspace marloues --",
    "publish:hot": "npm run publish:hot --workspace marloues --",
    "prepare:hot-pages": "npm run prepare:hot-pages --workspace marloues --",
    "verify:hot": "npm run verify:hot --workspace marloues --",
    "site:dev": "npm run dev --workspace @marloues/website",
    "site:build": "npm run build --workspace @marloues/website",
    "verify": "npm run test:layout && npm run lint && npm run typecheck && npm run test:unit && npm run test:contract && npm run build",
    "verify:push": "npm run test:layout && npm run lint && npm run typecheck && npm run test:unit",
    "prepare": "husky",
    "test:conversation:case": "node tests/visual/conversation-case.electron.mjs",
    "test:conversation:case:markdown": "node tests/visual/conversation-case-actions.mjs",
    "test:conversation:case:tools": "node tests/visual/conversation-case-tools.mjs",
    "test:conversation:case:report": "node tests/contract/conversation-generated-report.mjs"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": "node node_modules/eslint/bin/eslint.js --config client/eslint.config.mjs --fix",
    "client/**/*.{ts,tsx,css,json}": "node client/node_modules/prettier/bin/prettier.cjs --write",
    "tests/**/*.{ts,tsx,js,mjs,cjs}": "node node_modules/eslint/bin/eslint.js --config tests/eslint.config.mjs --fix",
    "tests/**/*.{ts,tsx,json,md}": "node client/node_modules/prettier/bin/prettier.cjs --write"
  },
  "devDependencies": {
    "@types/react": "~18.3.18",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sharp": "^0.35.3",
    "turbo": "^2.5.8"
  },
  "dependencies": {
    "remend": "^1.3.0"
  }
}
